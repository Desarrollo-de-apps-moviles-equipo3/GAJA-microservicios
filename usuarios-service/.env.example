# Copia este archivo a .env (esta en .gitignore) y completa con los datos de Supabase.
# Supabase -> Project Settings -> Database -> Connection string -> JDBC
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?prepareThreshold=0
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_PASSWORD=TU_CLAVE
